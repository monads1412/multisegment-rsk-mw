needs "HOL Light/enhanced/ms_dirty.hl";;
needs "HOL Light/utils.hl";;
needs "HOL Light/enhanced/segments_enhanced.hl";;



(* Will have to introduce a lemma proving that the set is nonempty. *)
let depth = new_definition
  `(depth : multisegment -> num -> num option) ms i =
    if is_nonempty_multisegment ms /\ i < |ms|
    then SOME
      (max_set
        ({dep:num |
            dep < |ms| /\
            ?c:num list.
              LENGTH c = dep + 1 /\
              headOf c = i /\
              (!k:num. k is_member_of c ==> k < |ms|) /\
              (!p:num. p + 1 < LENGTH c ==> (ms[c[p]]) << (ms[c[p+1]]))
        }))
    else NONE`;;



let d = new_definition
  `(d : multisegment -> num option) ms =
    if is_nonempty_multisegment ms
    then SOME
      (max_set{dep:num | ?i:num. i < |ms| /\ depth ms i = SOME dep})
    else NONE`;;



let bucket = new_definition
  `(bucket : multisegment -> num -> num -> bool) ms dep =
     {i:num | i < |ms| /\ depth ms i = SOME dep}`;;



let admissible_enumeration = new_definition
  `(admissible_enumeration :
      multisegment -> num -> (num list) option) ms k =
    if is_nonempty_multisegment ms
    then
      let dm = @dm:num. d ms = SOME dm in
      if k <= dm
      then SOME
        (@e:num list.(
            {i:num | i is_member_of e} = bucket ms k /\
              (!p q:num. (p < LENGTH e /\ q < LENGTH e /\ e[p] = e[q]) ==> p = q) /\
              (!i:num. (i is_member_of e  ==> i < |ms|)) /\
              (!p:num. p + 1 < LENGTH e ==>  (ms[e[p]]) seg_subset_eq (ms[e[p+1]]))
            )
        )
      else NONE
    else NONE`;;



let ivee = new_definition
  `(ivee : multisegment -> num -> num option) ms i =
    if is_nonempty_multisegment ms /\ i < |ms|
    then
      let k = @k:num. depth ms i = SOME k in
      let e = @e:num list. admissible_enumeration ms k = SOME e in
      let p = position_in e i in
      SOME
        (if p + 1 < LENGTH e
         then e[p+1]
         else headOf e)
    else NONE`;;



(* Delta'_i = [b(Delta_i), e(Delta_(i^vee))]. *)
let delta_prime = new_definition
  `(delta_prime :
      multisegment -> num -> segment option) ms i =
    if is_nonempty_multisegment ms /\ i < |ms|
    then
      let j = @j:num. ivee ms i = SOME j in
      SOME
        (mk_segment(segment_begin (ms[i]), segment_end (ms[j])))
    else NONE`;;