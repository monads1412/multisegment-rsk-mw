let is_segment = new_definition
  `(is_segment : (int#int) -> bool) s <=>
     FST s <= SND s`;;


(*proves that the type is not impossible by providing a witness*)
let SEGMENT_EXISTS = prove
  (`?s:int#int. is_segment s`,
   EXISTS_TAC `(&0,&0):int#int` THEN      (*this means that I supply the witness (0,0)*)
   SIMP_TAC[is_segment] THEN              (*after that I ask the simplifer to unfold the definition of is_segment*)
   INT_ARITH_TAC);;                       (*then I ask the simplifier to prove the arithmetic statement that 0<=0*)


(*this part creates the actual type*)
let segment_tybij =
  new_type_definition
    "segment"
    ("mk_segment",            (* converts a valid integer-pair representation into an abstract segment *)
      "segment_pair")         (* extracts the underlying integer-pair representation of a segment *)
    SEGMENT_EXISTS;;


let segment_begin = new_definition
  `(segment_begin : segment -> int) s =
     FST (segment_pair s)`;;


let segment_end = new_definition
  `(segment_end : segment -> int) s =
     SND (segment_pair s)`;;


let shift_left = new_definition
  `(shift_left : segment -> segment) s =
     mk_segment
       (segment_begin s - &1,
        segment_end s - &1)`;;


let truncate_left = new_definition
  `(truncate_left : segment -> segment option) s =
     if segment_begin s < segment_end s
     then SOME
       (mk_segment
         (segment_begin s + &1,
          segment_end s))
     else NONE`;;


parse_as_infix("<<",(12,"right"));;



let precedes = new_definition
  `(s1 << s2 <=>
     segment_begin s1 < segment_begin s2 /\
     segment_end s1 < segment_end s2)`;;



parse_as_infix("seg_subset_eq",(12,"right"));;

let seg_subset_eq_def = new_definition
  `((s1:segment) seg_subset_eq s2 <=>
      segment_begin s1 <= segment_begin s2 /\
      segment_end s2 <= segment_end s1)`;;
